# AFTERIMAGE — Event Platform
# Copy this file to `.env` (local dev) and fill in real values.
# NEVER commit `.env` or any file containing real secrets.

# --- Database -------------------------------------------------------------
# Pooled PostgreSQL connection used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/afterimage?schema=public"
# Direct (non-pooled) connection used only by `prisma migrate`.
# Neon: same URL with "-pooler" removed from the host.
# Local Postgres with no pooler: set this to the same value as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/afterimage?schema=public"

# --- Auth.js -----------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
# Canonical URL of the app. Required in production; optional in local dev.
AUTH_URL="http://localhost:3000"

# --- Google OAuth ----------------------------------------------------------
# Google Cloud Console -> Credentials -> OAuth 2.0 Client ID (Web application)
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- GitHub OAuth --------------------------------------------------------
# GitHub -> Settings -> Developer settings -> OAuth Apps
# Authorization callback URL: {AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Stripe (TEST MODE ONLY) ----------------------------------------------
# Dashboard -> Developers -> API keys (use the test-mode "Secret key", sk_test_...)
STRIPE_SECRET_KEY="sk_test_..."
# Signing secret for the webhook endpoint (whsec_...).
# Local: `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints one.
# Deployed: Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret.
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Resend (transactional email) ---------------------------------------
# https://resend.com -> API Keys
RESEND_API_KEY="re_..."
# Verified sender. Use "AFTERIMAGE <onboarding@resend.dev>" for local testing.
EMAIL_FROM="AFTERIMAGE <onboarding@resend.dev>"

# --- App -----------------------------------------------------------------
# Public base URL, used to build Stripe success/cancel URLs and links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Admin bootstrap ---------------------------------------------------------
# Comma-separated list of emails granted the ADMIN role on sign-in.
# This is the ONLY way to become an admin; roles are never client-settable.
ADMIN_EMAILS=""
